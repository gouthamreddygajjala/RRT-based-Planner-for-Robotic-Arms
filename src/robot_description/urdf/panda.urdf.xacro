<?xml version="1.0" encoding="utf-8"?>
<robot name="panda" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="$(find robot_description)/urdf/panda.macro.xacro" />
    <xacro:include filename="$(find robot_description)/urdf/panda.ros2_control.xacro" />

    <xacro:panda />
    <xacro:panda_ros2_control name="panda_system" />

    <gazebo>
        <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
            <parameters>$(find robot_bringup)/config/controllers.yaml</parameters>
        </plugin>
    </gazebo>

</robot>